# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.env

# Project artifacts — keep the dirs, exclude their contents
models/*
!models/.gitkeep
# Track the active deployed model so a fresh clone (e.g. on a Pi) can run
# inference without training. Backups (*.bak-*) and the COCO base stay out.
!models/best_yolov9c.pt
outputs/*
!outputs/.gitkeep
logs/*
!logs/.gitkeep
runs/

# Frontend build / deps
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Backend-served static frontend: normally generated by `npm run build`,
# but tracked here so a clone can serve the UI without Node/npm (e.g. Pi).

# IDE
.vscode/
.idea/
*.swp
.DS_Store
