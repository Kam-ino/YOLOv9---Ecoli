{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "backend.app.main:app",
        "--port",
        "8003"
      ],
      "port": 8003
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend"
      ],
      "port": 3003,
      "url": "http://127.0.0.1:3003"
    },
    {
      "name": "backend-for-vercel-preview",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "deploy\\serve-pc.bat",
        "http://localhost:4173",
        "8013"
      ],
      "port": 8013,
      "autoPort": false
    },
    {
      "name": "vercel-build-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--prefix",
        "frontend",
        "--",
        "--port",
        "4173",
        "--strictPort",
        "--outDir",
        "dist"
      ],
      "port": 4173,
      "url": "http://localhost:4173"
    }
  ]
}
